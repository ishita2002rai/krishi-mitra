# Kaggle API token (from https://www.kaggle.com/settings -> API -> Create New Token)
# Used by scripts/prepare_data.py to download the PlantVillage dataset.
KAGGLE_API_TOKEN=

# Legacy alternative (only if your Kaggle account still issues username+key pairs
# instead of a single token) -- leave blank if you're using KAGGLE_API_TOKEN above.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Groq API key (increment 2+, not used yet)
GROQ_API_KEY=
